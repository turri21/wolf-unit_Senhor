# Arcade-SmashTV source list (sourced by Arcade-SmashTV.qsf).
# NOTE: run quartus/build_sv2v.sh FIRST — it down-converts the SystemVerilog core
# (TMS34010 + yunit_*) to Quartus-friendly Verilog at build_syn/smashtv_core.v.

# --- SDC (SDRAM I/O timing; sys/ provides sys_top.sdc + derive_pll_clocks) ---
set_global_assignment -name SDC_FILE rtl/sdram.sdc

# --- emu wrapper (Quartus-native SystemVerilog; instantiates yunit_top by name) ---
set_global_assignment -name SYSTEMVERILOG_FILE Arcade-WolfUnit.sv

# --- USE_DDR3_GFX only: gfx ROM download interleave transform (plain comb SV, no sv2v needed) ---
set_global_assignment -name SYSTEMVERILOG_FILE rtl/wolf/wolf_gfx_interleave.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/wolf/wolf_gfxdl_fifo.sv

# --- the sv2v'd core blob (yunit_top + TMS34010 + all yunit_* + sdram) ---
set_global_assignment -name VERILOG_FILE build_syn/smashtv_core.v

# --- PLL (edited to 3 outputs: clk_sys 96 / clk_sdram 96-shift / clk_snd 12) ---
set_global_assignment -name QIP_FILE rtl/pll.qip

# --- Williams CVSD sound board (VHDL + Verilog; NOT sv2v'd) + jt51 YM2151 ---
set_global_assignment -name VHDL_FILE rtl/sound/williams_cvsd/gen_ram.vhd
set_global_assignment -name VHDL_FILE rtl/sound/williams_cvsd/hc55564.vhd
set_global_assignment -name VHDL_FILE rtl/sound/williams_cvsd/pia6821.vhd
set_global_assignment -name VHDL_FILE rtl/sound/williams_cvsd/williams_cvsd_board.vhd
set_global_assignment -name VERILOG_FILE rtl/sound/williams_cvsd/mc6809is.v
set_global_assignment -name QIP_FILE rtl/sound/jt51/hdl/jt51.qip

set_global_assignment -name SYSTEMVERILOG_FILE rtl/pkg/wolf_pkg.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/pkg/yunit_pkg.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/tms34010/rtl/tms34010_pkg.sv

set_global_assignment -name SYSTEMVERILOG_FILE rtl/tms34010/rtl/core/tms34010_alu.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/tms34010/rtl/core/tms34010_core.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/tms34010/rtl/core/tms34010_decode.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/tms34010/rtl/core/tms34010_divider.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/tms34010/rtl/core/tms34010_int_ctrl.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/tms34010/rtl/core/tms34010_pc.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/tms34010/rtl/core/tms34010_regfile.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/tms34010/rtl/core/tms34010_shifter.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/tms34010/rtl/core/tms34010_status_reg.sv

set_global_assignment -name SYSTEMVERILOG_FILE rtl/tms34010/rtl/io/tms34010_io_regs.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/tms34010/rtl/video/tms34010_video.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/tms34010/rtl/video/tms34010_refresh.sv

set_global_assignment -name SYSTEMVERILOG_FILE rtl/yunit/yunit_mem_cdc.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/yunit/yunit_video.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/yunit/yunit_video_top.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/yunit/yunit_top.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/yunit/yunit_scanline.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/yunit/yunit_palram.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/yunit/yunit_memsys.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/yunit/yunit_mem.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/yunit/yunit_gfx_unpack.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/yunit/yunit_dma.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/yunit/vram_sdram_top.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/yunit/vram_sdram.sv

set_global_assignment -name SYSTEMVERILOG_FILE rtl/sdram/sdram.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/sdram/sdram_burst.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/sdram/sdram_phy.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/sdram/sdram_stock.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/sdram/stv_vram_ddr_agent.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/sdram/stv_vram_ddr_top.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/sdram/wolf_dcs_ddr_top.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/sdram/wolf_ddr3_arb.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/sdram/wolf_gfx_ddr_top.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/sdram/yunit_sdram_adapter.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/sdram/yunit_sdram_arb.sv