# --------------------------------------------------------------------------
#  Arcade-SmashTV (Williams Y-unit) — MiSTer project
#  Do not add files in the Quartus IDE; edit files.qip manually.
# --------------------------------------------------------------------------

set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top

set_global_assignment -name LAST_QUARTUS_VERSION "17.0.2 Lite Edition"

set_global_assignment -name GENERATE_RBF_FILE ON
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files/q256_scanfix
set_global_assignment -name NUM_PARALLEL_PROCESSORS 8
set_global_assignment -name SAVE_DISK_SPACE OFF
set_global_assignment -name SMART_RECOMPILE OFF
set_global_assignment -name MIN_CORE_JUNCTION_TEMP "-40"
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 125
set_global_assignment -name POWER_PRESET_COOLING_SOLUTION "23 MM HEAT SINK WITH 200 LFPM AIRFLOW"
set_global_assignment -name POWER_BOARD_THERMAL_MODEL "NONE (CONSERVATIVE)"
set_global_assignment -name OPTIMIZE_POWER_DURING_FITTING OFF
set_global_assignment -name FINAL_PLACEMENT_OPTIMIZATION ALWAYS
set_global_assignment -name FITTER_EFFORT "STANDARD FIT"
set_global_assignment -name OPTIMIZATION_MODE BALANCED
set_global_assignment -name ALLOW_POWER_UP_DONT_CARE ON
set_global_assignment -name QII_AUTO_PACKED_REGISTERS NORMAL
set_global_assignment -name ROUTER_LCELL_INSERTION_AND_LOGIC_DUPLICATION ON
set_global_assignment -name PHYSICAL_SYNTHESIS_COMBO_LOGIC ON
set_global_assignment -name PHYSICAL_SYNTHESIS_REGISTER_DUPLICATION ON
set_global_assignment -name PHYSICAL_SYNTHESIS_REGISTER_RETIMING ON
set_global_assignment -name OPTIMIZATION_TECHNIQUE SPEED
set_global_assignment -name MUX_RESTRUCTURE ON
set_global_assignment -name REMOVE_REDUNDANT_LOGIC_CELLS ON
set_global_assignment -name AUTO_DELAY_CHAINS_FOR_HIGH_FANOUT_INPUT_PINS ON
set_global_assignment -name PHYSICAL_SYNTHESIS_COMBO_LOGIC_FOR_AREA ON
set_global_assignment -name ADV_NETLIST_OPT_SYNTH_WYSIWYG_REMAP ON
set_global_assignment -name SYNTH_GATED_CLOCK_CONVERSION ON
set_global_assignment -name PRE_MAPPING_RESYNTHESIS ON
set_global_assignment -name ROUTER_CLOCKING_TOPOLOGY_ANALYSIS ON
set_global_assignment -name ECO_OPTIMIZE_TIMING ON
set_global_assignment -name PERIPHERY_TO_CORE_PLACEMENT_AND_ROUTING_OPTIMIZATION ON
set_global_assignment -name PHYSICAL_SYNTHESIS_ASYNCHRONOUS_SIGNAL_PIPELINING ON
set_global_assignment -name ALM_REGISTER_PACKING_EFFORT HIGH
set_global_assignment -name PLACEMENT_EFFORT_MULTIPLIER 3.0
set_global_assignment -name SEED 5

# Smash T.V. is a horizontal core — no framebuffer/rotation (MISTER_FB off).

source sys/sys.tcl
source sys/sys_analog.tcl
source files.qip

set_global_assignment -name CDF_FILE jtag.cdf
set_global_assignment -name QIP_FILE sys/sys.qip
set_global_assignment -name SDC_FILE senhor_constraints.sdc
set_global_assignment -name QIP_FILE rtl/pll.qip
set_global_assignment -name SDC_FILE rtl/sdram.sdc
set_global_assignment -name SYSTEMVERILOG_FILE "Arcade-SmashTV.sv"
set_global_assignment -name VERILOG_FILE build_syn/smashtv_core.v
set_global_assignment -name VHDL_FILE rtl/sound/williams_cvsd/gen_ram.vhd
set_global_assignment -name VHDL_FILE rtl/sound/williams_cvsd/hc55564.vhd
set_global_assignment -name VHDL_FILE rtl/sound/williams_cvsd/pia6821.vhd
set_global_assignment -name VHDL_FILE rtl/sound/williams_cvsd/williams_cvsd_board.vhd
set_global_assignment -name VERILOG_FILE rtl/sound/williams_cvsd/mc6809is.v
set_global_assignment -name QIP_FILE rtl/sound/jt51/hdl/jt51.qip


set_global_assignment -name SYSTEMVERILOG_FILE rtl/wolf/ram_sdram.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/wolf/wolf_dcs_board.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/wolf/wolf_dcs_stub.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/wolf/wolf_dma.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/wolf/wolf_gfxdl_guard.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/wolf/wolf_mem.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/wolf/wolf_memsys.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/wolf/wolf_palram.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/wolf/wolf_pic.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/wolf/wolf_top.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/wolf/wolf_video.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/wolf/wolf_video_post.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/wolf/wolf_video_top.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/wolf/wolf_gfx_interleave.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/wolf/wolf_gfxdl_fifo.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/wolf/wolf_game_inputs.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/wolf/wolf_nvram_bridge.sv

set_global_assignment -name SYSTEMVERILOG_FILE rtl/dcs/adsp2105.sv


set_global_assignment -name VERILOG_MACRO "SYNTHESIS=1"
set_global_assignment -name VERILOG_MACRO "MK3=1"
set_global_assignment -name VERILOG_MACRO "USE_DDR3_GFX=1"
set_global_assignment -name VERILOG_MACRO "USE_DDR3_VRAM=1"

set_global_assignment -name TIMEQUEST_MULTICORNER_ANALYSIS ON
set_global_assignment -name TOP_LEVEL_ENTITY sys_top
set_global_assignment -name VERILOG_INPUT_VERSION VERILOG_2001
set_global_assignment -name VERILOG_SHOW_LMF_MAPPING_MESSAGES OFF
set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top