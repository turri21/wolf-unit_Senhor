          instr[11:8] == CC_LS ||
          instr[11:8] == CC_HI ||
          instr[11:8] == CC_LT ||
@@ -2062,7 +2062,7 @@ module tms34010_decode
     if (instr[15:12] == JRCC_TOP4 &&
         instr[7:0] == 8'h00 &&
         (instr[11:8] == CC_UC ||
-         instr[11:8] == CC_LO ||
+         instr[11:8] == CC_P  ||
          instr[11:8] == CC_LS ||
          instr[11:8] == CC_HI ||
          instr[11:8] == CC_LT ||
@@ -2267,7 +2267,7 @@ module tms34010_decode
     if (instr[15:12] == JRCC_TOP4 &&
         instr[7:0] == 8'h80 &&
         (instr[11:8] == CC_UC ||
-         instr[11:8] == CC_LO ||
+         instr[11:8] == CC_P  ||
          instr[11:8] == CC_LS ||
          instr[11:8] == CC_HI ||
          instr[11:8] == CC_LT ||
diff --git a/rtl/tms34010_pkg.sv b/rtl/tms34010_pkg.sv
index 7a85b94..e0dd9f5 100644
--- a/rtl/tms34010_pkg.sv
+++ b/rtl/tms34010_pkg.sv
@@ -575,7 +575,9 @@ package tms34010_pkg;
   // guess of EQ=0100 and NE=0111 was WRONG — those codes are actually
   // LT and GT, respectively. Corrected in Task 0030; see A0023.
   parameter logic [3:0] CC_UC = 4'b0000;  // unconditional
-  parameter logic [3:0] CC_LO = 4'b0001;  // lower-than       (unsigned; C = 1; alias "B")
+  parameter logic [3:0] CC_P  = 4'b0001;  // P: positive/>0   (~N & ~Z)  [P0004: was mislabeled
+                                           // CC_LO=st_c. TMS34010 code 0001 is P (JRP), not
+                                           // unsigned-lower — that is code 1000 = CC_C (borrow).]
   parameter logic [3:0] CC_LS = 4'b0010;  // lower-or-same    (unsigned; C | Z = 1)
   parameter logic [3:0] CC_HI = 4'b0011;  // higher-than      (unsigned; ~C & ~Z = 1)
   parameter logic [3:0] CC_LT = 4'b0100;  // less-than        (signed;   N ^ V = 1)
