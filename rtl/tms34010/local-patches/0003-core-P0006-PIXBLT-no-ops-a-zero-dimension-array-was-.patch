From 3a3ebe4baf27c473c66c7110ad4256d8a9537477 Mon Sep 17 00:00:00 2001
From: Matt Levine <blahm1d@gmail.com>
Date: Sun, 5 Jul 2026 01:14:02 -0800
Subject: [PATCH 03/12] core: P0006 - PIXBLT no-ops a zero-dimension array (was
 hanging)

A PIXBLT with dX=0 or dY=0 transfers no pixels (TMS34010 UG). The core had no
guard, so pblt_done's (pblt_dy_q - 1) underflowed to 0xFFFF -> 65536 rows -> hang.
Smash T.V. attract issues DYDX=0 for blank tiles. Guard CORE_PBLT_SETUP to skip
to CORE_FETCH when either dimension is 0. Verified: the draw loop now completes
the full 263-object attract layer (was hanging at object 176).

---
 PATCHES.md                | 23 +++++++++++++++++++++++
 rtl/core/tms34010_core.sv |  7 ++++++-
 2 files changed, 29 insertions(+), 1 deletion(-)

diff --git a/PATCHES.md b/PATCHES.md
index 76aec8c..b8e136d 100644
--- a/PATCHES.md
+++ b/PATCHES.md
@@ -188,3 +188,26 @@ draw loop then renders 231 attract objects (was 1) via PIXBLT.
 **Upstream note (P0004+P0005).** Both are real TMS34010 core bugs — offer upstream to
 birdybro. Neither is Y-unit-specific; they only surfaced running real game code (the
 per-instruction unit TBs didn't exercise `JRP`-after-`CMP` or the `SRL` K-form encoding).
+
+---
+
+## P0006 — PIXBLT/FILL with a zero-dimension array hangs (must no-op)
+
+**Status:** ✅ APPLIED + VERIFIED 2026-07-05. `grep -rn P0006 rtl/`.
+
+**Applied edit:** `rtl/core/tms34010_core.sv` (`CORE_PBLT_SETUP` state transition) —
+`state_d = (pblt_dx_q == 0 || pblt_dy_q == 0) ? CORE_FETCH : ...` (skip the draw).
+
+**Problem.** A PIXBLT whose array has ΔX=0 or ΔY=0 transfers no pixels (TMS34010 UG:
+"if either dimension of the array is 0, no pixels are transferred"). The core had no
+guard, so `pblt_done = pblt_row_end && (pblt_y_q == pblt_dy_q - 1)` computed
+`pblt_dy_q - 1 = 0xFFFF` for ΔY=0 and ran 65536 rows → effective hang.
+
+**Evidence (real ROM).** Smash T.V. attract draws blank tiles: object #176's
+dimension-table entry (`*A4` @ `FFF54B10+...`) is `0x00000000` → `DYDX=0`; the game
+issues `PIXBLT B,XY` with it and relies on the 34010 no-opping it. Post-fix the draw
+loop completes the full 263-object attract layer (was hanging at object 176).
+
+**Note.** Only `CORE_PBLT_SETUP` is guarded (covers all PIXBLT forms — the check runs
+before the binary/windowed sub-setups). FILL uses a separate FSM; if a 0-dimension FILL
+ever appears, add the analogous guard to its setup.
diff --git a/rtl/core/tms34010_core.sv b/rtl/core/tms34010_core.sv
index 3e8cb4a..cc504d5 100644
--- a/rtl/core/tms34010_core.sv
+++ b/rtl/core/tms34010_core.sv
@@ -2733,7 +2733,12 @@ module tms34010_core
         // One cycle to latch SPTCH/DPTCH (counters seeded at EXECUTE). The
         // binary form reads COLOR0/COLOR1 in a second setup cycle; a windowed
         // (W=3) XY blt reads WSTART/WEND in CORE_PBLT_SETUP_WIN.
-        state_d = decoded.blt_binary                          ? CORE_PBLT_SETUP2
+        // P0006: a zero-dimension array transfers no pixels (TMS34010 UG:
+        // "if either dimension of the array is 0, no pixels are transferred").
+        // Without this, pblt_done's `pblt_dy_q - 1` underflows to 0xFFFF and the
+        // blt runs 65536 rows -> hang. Real games issue DYDX=0 for blank tiles.
+        state_d = (pblt_dx_q == 16'd0 || pblt_dy_q == 16'd0)  ? CORE_FETCH
+                : decoded.blt_binary                          ? CORE_PBLT_SETUP2
                 : (pblt_win_en_q || pblt_w2_q || pblt_w1_q)   ? CORE_PBLT_SETUP_WIN
                                                               : CORE_PBLT;
       end
